# RideShare environment configuration

ENVIRONMENT=development

# Database connection URL (Port 5433 matches the Docker container)
DATABASE_URL=postgresql+psycopg2://postgres:password123@localhost:5433/ridemate_dev
TEST_DATABASE_URL=postgresql+psycopg2://postgres:password123@localhost:5433/ridemate_test

# Authentication Settings
JWT_SECRET_KEY=9a6d51c33ea98fd165b4528f8ac2da76fa1c305a41ca49e6dcf38fbbdc16f5c8
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# URLs and CORS
