# RideShare environment configuration example

# Environment indicator (development / production)
ENVIRONMENT=development

# Database connection URL
# Formats: postgresql+psycopg2://user:password@host:port/dbname
DATABASE_URL=postgresql+psycopg2://postgres:password123@localhost:5432/ridemate_dev
TEST_DATABASE_URL=postgresql+psycopg2://postgres:password123@localhost:5432/ridemate_test

# Authentication Settings
# To generate a secure secret key: openssl rand -hex 32
JWT_SECRET_KEY=9a6d51c33ea98fd165b4528f8ac2da76fa1c305a41ca49e6dcf38fbbdc16f5c8
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# URLs and CORS
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Cookie Settings
COOKIE_SECURE=False
# Can be Lax, Strict, or None (Lax is recommended for development)
COOKIE_SAMESITE=Lax

# Safety / Block settings (optional/limit parameters)
RATE_LIMIT_LOGIN_PER_MIN=5
